{
  "name": "dsh-unknownue-plugins",
  "version": "0.4.0",
  "description": "Personal DSH plugin bundle (unknownue): Makefile panel, content-width, open-workspace, SSH remote workspaces, authenticated gateway, file explorer, a personal task board (PGlite), and an in-process paperspace academic-paper reader (PGlite, no Docker).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./paperspace": "./lib/paperspace/index.js",
    "./tasks": "./lib/tasks/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:client": "node esbuild.config.mjs client",
    "build:host": "node esbuild.config.mjs host",
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.host.json",
    "test": "node lib/explorer.test.js && node lib/paperspace/paperspace.test.js && node lib/tasks/tasks.test.js"
  },
  "files": [
    "lib",
    "src/client",
    "src/host",
    "cordis.patch.yml",
    "README.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "license": "MIT",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "make",
    "makefile",
    "build",
    "remote",
    "gateway",
    "workspace",
    "paperspace",
    "arxiv",
    "papers",
    "reader",
    "translation",
    "pglite",
    "tasks",
    "task-board",
    "kanban",
    "todo"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/node": "^22.19.0",
    "@types/react": "^18.2.0",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-attachment": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-brand": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-code-runtime": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-invariants": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-scope": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-timeout": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "^0.0.1-rc.1",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "cheerio": "^1.2.0",
    "dsh-workspace-enhancement": "^0.1.0",
    "fast-xml-parser": "^5.11.1",
    "github-slugger": "^2.0.0",
    "katex": "^0.16.47",
    "marked": "^15.0.0",
    "postgres": "^3.4.9",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^3.25.76"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
