{
  "name": "dsh-unknownue-plugins",
  "version": "0.3.0",
  "description": "Personal DSH plugin bundle (unknownue): Makefile panel, content-width, open-workspace, SSH remote workspaces (via dsh-workspace-enhancement), authenticated gateway (via dsh-gateway).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:client": "node esbuild.config.mjs client",
    "build:host": "node esbuild.config.mjs host",
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.host.json",
    "test": "node lib/explorer.test.js"
  },
  "files": [
    "lib",
    "src/client",
    "src/host",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "make",
    "makefile",
    "build",
    "remote",
    "gateway",
    "workspace"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^18.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "dsh-workspace-enhancement": "^0.1.0",
    "marked": "^15.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
